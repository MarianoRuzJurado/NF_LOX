params {
    sample      = null
    r1          = null
    r2          = null
    reference   = null
    whitelist   = null
    common_snvs = "${projectDir}/resources/GRCh38_Common_Xlinked_SNVs.repaired.vcf.gz"
    xcise_dir   = "${projectDir}/resources"
    outdir      = "results"
}

conda {
    enabled = true
}

process {

    cpus   = 8
    memory = '16 GB'
    time   = '24h'

    withName: STAR_ALIGN {
        cpus   = 42
        memory = '168 GB'
        time   = '24h'
    }

    withName: SAMTOOLS_INDEX {
        cpus   = 8
        memory = '16 GB'
        time   = '2h'
    }

    withName: CALL_VARIANTS {
        cpus   = 8
        memory = '16 GB'
        time   = '12h'
    }

    withName: NORMALIZE_VARIANTS {
        cpus   = 8
        memory = '16 GB'
        time   = '4h'
    }

    withName: ISEC_VARIANTS {
        cpus   = 32
        memory = '64 GB'
        time   = '4h'
    }

    withName: WASP_VCF {
        cpus   = 8
        memory = '16 GB'
        time   = '2h'
    }

    withName: STAR_WASP {
        cpus   = 42
        memory = '168 GB'
        time   = '24h'
    }

    withName: SAMTOOLS_INDEX_WASP {
        cpus   = 8
        memory = '16 GB'
        time   = '2h'
    }

    withName: XCISE_IMPLEMENTATION {
        cpus = 8
        memory = '16 GB'
        time = '2h'
    }
}