process NORMALIZE_VARIANTS {

    tag "$sample"

    input:

    /*
     * VCF generated by bcftools call.
     */
    tuple val(sample), path(vcf)

    /*
     * Reference genome.
     */
    path genome_fasta


    output:

    tuple val(sample),
          path("${sample}variants_normalized.vcf.gz"),
          path("${sample}variants_normalized.vcf.gz.csi"),
          emit: normalized_variants


    script:

    """
    bcftools norm \
        -m-any \
        --check-ref \
        -w \
        -f ${genome_fasta} \
        ${vcf} \
        -Oz \
        -o ${sample}variants_normalized.vcf.gz

    bcftools index \
        ${sample}variants_normalized.vcf.gz

    """
}